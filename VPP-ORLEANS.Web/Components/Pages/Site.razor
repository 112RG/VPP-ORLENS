@page "/site"
@rendermode InteractiveServer
@inject VPP_ORLEANS.Web.SiteApiClient Client
@using VPP_ORLEANS.GrainInterfaces

<PageTitle>Sites</PageTitle>

<h1>Sites</h1>

<div class="mb-3">
    <div class="input-group">
        <input @bind="newSiteTitle" @bind:event="oninput"
               class="form-control" placeholder="Add a site..." />
        <button class="btn btn-primary" @onclick="AddSite" disabled="@(string.IsNullOrWhiteSpace(newSiteTitle))">
            Add
        </button>
    </div>
</div>

@if (sites is null)
{
    <p>Loading...</p>
}
else if (sites.Length == 0)
{
    <p class="text-muted">No sites yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var site in sites)
        {
            <li class="list-group-item">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           checked="@site.IsActive"
                           @onchange="() => ToggleSite(site.Title)" />
                    <label class="form-check-label @(site.IsActive ? "text-decoration-line-through text-muted" : "")">
                        @site.Title
                    </label>
                </div>

                <div class="ms-4 mt-1">
                    @if (assetsBySite.TryGetValue(site.Title, out var assets) && assets.Length > 0)
                    {
                        <ul class="list-unstyled small mb-1">
                            @foreach (var asset in assets)
                            {
                                <li class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge @(asset.IsOnline ? "bg-success" : "bg-secondary")">
                                        @(asset.Kind == AssetKind.Battery ? "BATTERY" : "SOLAR")
                                    </span>
                                    <span>@asset.AssetId</span>
                                    <span class="text-muted">@asset.CurrentKw.ToString("0.0") kW</span>
                                    <span class="text-muted">@(asset.IsOnline ? "online" : "offline")</span>

                                    @if (asset.Kind == AssetKind.Battery)
                                    {
                                        <input class="form-control form-control-sm d-inline-block" style="width: 5rem"
                                               @bind="dispatchText[asset.AssetId]" placeholder="kW" />
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => Dispatch(asset.AssetId, site.Title)">
                                            Dispatch
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted small">No assets</span>
                    }

                    <div class="input-group input-group-sm" style="max-width: 26rem">
                        <input class="form-control" placeholder="asset id"
                               @bind="newAssetIdBySite[site.Title]" />
                        <button class="btn btn-outline-success"
                                @onclick="() => AddAsset(site.Title, AssetKind.Battery)">
                            +Battery
                        </button>
                        <button class="btn btn-outline-info"
                                @onclick="() => AddAsset(site.Title, AssetKind.Solar)">
                            +Solar
                        </button>
                    </div>
                </div>
            </li>
        }
    </ul>
}

@if (sites is not null)
{
    <nav class="mt-3 d-flex align-items-center justify-content-between">
        <span class="text-muted small">
            @{ var first = sites.Length == 0 ? 0 : (page - 1) * PageSize + 1; }
            @first-@((page - 1) * PageSize + sites.Length) of @total
        </span>
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(page <= 1)" @onclick="PrevPage">Prev</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(page >= totalPages)" @onclick="NextPage">Next</button>
        </div>
    </nav>
}

@code {
    private const int PageSize = 25;
    private string newSiteTitle = "";
    private VPP_ORLEANS.Contracts.SiteItem[]? sites;
    private int page = 1;
    private int total;
    private int totalPages = 1;

    private Dictionary<string, Contracts.AssetItem[]> assetsBySite = new();
    private Dictionary<string, string> newAssetIdBySite = new();
    private Dictionary<string, string> dispatchText = new();

    protected override Task OnInitializedAsync() => LoadPageAsync();

    private async Task LoadPageAsync()
    {
        var response = await Client.GetSitesAsync(page, PageSize);
        sites = response.Sites;
        total = response.Total;
        totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        await LoadAssetsAsync();
    }

    private async Task LoadAssetsAsync()
    {
        var current = sites ?? [];
        var results = await Task.WhenAll(current.Select(s => Client.GetAssetsAsync(s.Title)));
        assetsBySite = current
            .Zip(results, (s, assets) => (s.Title, assets))
            .ToDictionary(x => x.Title, x => x.assets);
    }

    private async Task AddSite()
    {
        await Client.AddAsync(newSiteTitle);
        newSiteTitle = "";
        page = 1;
        await LoadPageAsync();
    }

    private async Task ToggleSite(string title)
    {
        var item = await Client.ToggleAsync(title);
        if (sites is null) return;
        var index = Array.FindIndex(sites, s => s.Title == title);
        if (index >= 0)
            sites[index] = item;
    }

    private async Task AddAsset(string siteTitle, AssetKind kind)
    {
        var assetId = newAssetIdBySite.TryGetValue(siteTitle, out var value) ? value.Trim() : "";
        if (string.IsNullOrWhiteSpace(assetId))
            return;

        var item = await Client.AddAssetAsync(siteTitle, kind, assetId);

        if (assetsBySite.TryGetValue(siteTitle, out var list))
            assetsBySite[siteTitle] = [.. list, item];
        else
            assetsBySite[siteTitle] = [item];

        newAssetIdBySite[siteTitle] = "";
    }

    private async Task Dispatch(string assetId, string siteTitle)
    {
        if (!double.TryParse(dispatchText.GetValueOrDefault(assetId), out var kw))
            return;

        await Client.DispatchBatteryAsync(assetId, kw);
        dispatchText[assetId] = kw.ToString("0.0");

        var assets = await Client.GetAssetsAsync(siteTitle);
        assetsBySite[siteTitle] = assets;
    }

    private async Task PrevPage()
    {
        if (page <= 1) return;
        page--;
        await LoadPageAsync();
    }

    private async Task NextPage()
    {
        if (page >= totalPages) return;
        page++;
        await LoadPageAsync();
    }
}