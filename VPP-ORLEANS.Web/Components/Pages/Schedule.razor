@page "/schedule"
@using GrainInterfaces
@rendermode InteractiveServer
@inject VPP_ORLEANS.Web.ScheduleApiClient Client
@implements IDisposable

<PageTitle>Schedule</PageTitle>

<h1>Task Schedule</h1>

<p class="text-muted small">
    Last tick: @(lastTick == default ? "--" : lastTick.ToString("HH:mm:ss"))
    <span class="ms-2 badge bg-success">live</span>
</p>

<div class="mb-3">
    <div class="input-group">
        <input @bind="newTaskTitle" @bind:event="oninput"
               class="form-control" placeholder="Add a task..." />
        <button class="btn btn-primary" @onclick="AddTask" disabled="@(string.IsNullOrWhiteSpace(newTaskTitle))">
            Add
        </button>
    </div>
</div>

@if (tasks is null)
{
    <p>Loading...</p>
}
else if (!tasks.Any())
{
    <p class="text-muted">No tasks yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var task in tasks)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           checked="@task.IsDone"
                           @onchange="() => ToggleTask(task.Title)" />
                    <label class="form-check-label @(task.IsDone ? "text-decoration-line-through text-muted" : "")">
                        @task.Title
                    </label>
                </div>
            </li>
        }
    </ul>
}

@code {
    private string newTaskTitle = "";
    private ScheduleItem[]? tasks;
    private DateTimeOffset lastTick;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        var response = await Client.GetAllAsync();
        tasks = response.Tasks;
        lastTick = response.LastTick;
        _ = PollTickAsync();
    }

    private async Task PollTickAsync()
    {
        _pollCts = new CancellationTokenSource();
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        try
        {
            while (await timer.WaitForNextTickAsync(_pollCts.Token))
            {
                var response = await Client.GetAllAsync(_pollCts.Token);
                lastTick = response.LastTick;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task AddTask()
    {
        var response = await Client.AddAsync(newTaskTitle);
        tasks = response.Tasks;
        lastTick = response.LastTick;
        newTaskTitle = "";
    }

    private async Task ToggleTask(string title)
    {
        var response = await Client.ToggleAsync(title);
        tasks = response.Tasks;
        lastTick = response.LastTick;
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}